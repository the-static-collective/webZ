{
  "name": "webz-offline-porch",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "test:browser": "python tests/browser.py && python tests/races.py && python tests/field-browser.py && npm run test:moving-browser",
    "replay": "node scripts/replay.mjs",
    "field:build": "node scripts/build-field.mjs",
    "field:verify": "node scripts/build-field.mjs --check",
    "test:field-browser": "python tests/field-browser.py",
    "field:census": "node scripts/field-census.mjs",
    "field:replay": "node scripts/replay-moving-field.mjs",
    "test:moving-browser": "node tests/moving-preview.mjs",
    "field:export": "node scripts/export-field.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
