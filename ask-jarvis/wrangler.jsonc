{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ask-jarvis",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
