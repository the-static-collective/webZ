{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webZ public-field/v0 \u2014 founding inspection-only profile",
  "description": "Structural schema. Node field:verify additionally checks reviewed sources, unique IDs, relation targets, local routes, generated HTML, receipt and exact cache version. No LIVE or available remote-effect claims are supported in this founding profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "observedOn",
    "laws",
    "worlds",
    "relations"
  ],
  "properties": {
    "schema": {
      "const": "webz/public-field/v0"
    },
    "profile": {
      "const": "inspection-only-001"
    },
    "observedOn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "laws": {
      "const": [
        "THE WEB IS A PORCH, NOT THE HOUSE",
        "VISIBLE DOOR != AUTHORITY",
        "DOOR != EFFECT",
        "CLICK != ADMISSION",
        "LINK != CROSSING",
        "CODE EXISTS != SERVICE EXISTS",
        "CI GREEN != PUBLIC DEPLOYMENT",
        "DEPLOYABLE != DEPLOYED",
        "RELATION != AUTHORITY",
        "PUBLIC SOURCE != PUBLIC CAPABILITY",
        "HOLD != FAILURE",
        "UNKNOWN != DENIED",
        "FILE != UPLOAD",
        "WEBZ != RADIO PLAYER",
        "WEBZ != BROADCASTER",
        "WEBZ != STATION",
        "WEB VISIBILITY != MACHINE CAPABILITY",
        "EXECUTOR EXISTS != PUBLIC EXECUTION SERVICE",
        "SOURCE != EXECUTION",
        "PROPOSAL != ADMISSION"
      ]
    },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "shortDescription",
          "category",
          "ownerSystem",
          "ownerRepo",
          "source",
          "additionalSources",
          "state",
          "current",
          "publicSurface",
          "doors",
          "authoritySummary",
          "nextGate",
          "laws"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "shortDescription": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "category": {
            "enum": [
              "ENTER",
              "MAKE",
              "LISTEN",
              "READ",
              "CROSS",
              "BUILD",
              "COMPUTE",
              "PLAY",
              "OBSERVE"
            ]
          },
          "ownerSystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "ownerRepo": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "pattern": "^the-static-collective/[A-Za-z0-9-]+$"
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "ref",
              "exactCommit",
              "observedContract"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^the-static-collective/[A-Za-z0-9-]+$"
              },
              "ref": {
                "type": "string",
                "pattern": "^refs/(pull/[0-9]+/head|heads/[a-z0-9/-]+)$"
              },
              "exactCommit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "observedContract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          },
          "additionalSources": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "ref",
                "exactCommit",
                "observedContract"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^the-static-collective/[A-Za-z0-9-]+$"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^refs/(pull/[0-9]+/head|heads/[a-z0-9/-]+)$"
                },
                "exactCommit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "observedContract": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              }
            }
          },
          "state": {
            "enum": [
              "LIVE",
              "LOCAL_ONLY",
              "INSPECTABLE",
              "PROPOSAL_ONLY",
              "HOLD",
              "NOT_CONNECTED",
              "EXPERIMENTAL"
            ]
          },
          "current": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "publicSurface": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "target",
              "deploymentEvidence",
              "adoption"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "LOCAL_ROUTE",
                  "SOURCE_ONLY"
                ]
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deploymentEvidence": {
                "type": "null"
              },
              "adoption": {
                "const": "NOT_CLAIMED"
              }
            }
          },
          "doors": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "doorId",
                "label",
                "kind",
                "effectClass",
                "target",
                "owner",
                "availability",
                "reason",
                "requiredNextAuthority"
              ],
              "properties": {
                "doorId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "maxLength": 80
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "kind": {
                  "enum": [
                    "LOCAL",
                    "SOURCE",
                    "OWNER_SITE",
                    "CAPABILITY"
                  ]
                },
                "effectClass": {
                  "enum": [
                    "LOCAL_NAVIGATION",
                    "LOCAL_COMPUTE",
                    "LOCAL_PROPOSAL",
                    "PROOF_INSPECTION",
                    "EXTERNAL_NAVIGATION",
                    "REMOTE_EFFECT"
                  ]
                },
                "target": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 500
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "availability": {
                  "enum": [
                    "AVAILABLE",
                    "HOLD",
                    "NO",
                    "NOT_YET",
                    "UNKNOWN"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "requiredNextAuthority": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "effectClass": {
                        "const": "REMOTE_EFFECT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "availability": {
                        "const": "HOLD"
                      },
                      "target": {
                        "type": "null"
                      },
                      "kind": {
                        "const": "CAPABILITY"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "availability": {
                        "not": {
                          "const": "AVAILABLE"
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "target": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "authoritySummary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "nextGate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "laws": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "enum": [
                "THE WEB IS A PORCH, NOT THE HOUSE",
                "VISIBLE DOOR != AUTHORITY",
                "DOOR != EFFECT",
                "CLICK != ADMISSION",
                "LINK != CROSSING",
                "CODE EXISTS != SERVICE EXISTS",
                "CI GREEN != PUBLIC DEPLOYMENT",
                "DEPLOYABLE != DEPLOYED",
                "RELATION != AUTHORITY",
                "PUBLIC SOURCE != PUBLIC CAPABILITY",
                "HOLD != FAILURE",
                "UNKNOWN != DENIED",
                "FILE != UPLOAD",
                "WEBZ != RADIO PLAYER",
                "WEBZ != BROADCASTER",
                "WEBZ != STATION",
                "WEB VISIBILITY != MACHINE CAPABILITY",
                "EXECUTOR EXISTS != PUBLIC EXECUTION SERVICE",
                "SOURCE != EXECUTION",
                "PROPOSAL != ADMISSION"
              ]
            }
          }
        },
        "allOf": [
          {
            "not": {
              "properties": {
                "state": {
                  "const": "LIVE"
                }
              }
            }
          }
        ]
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "source",
          "description"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "observes",
              "references",
              "can-propose-to",
              "can-receive-from",
              "neighbor-of"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "ref",
              "exactCommit",
              "observedContract"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^the-static-collective/[A-Za-z0-9-]+$"
              },
              "ref": {
                "type": "string",
                "pattern": "^refs/(pull/[0-9]+/head|heads/[a-z0-9/-]+)$"
              },
              "exactCommit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "observedContract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    }
  }
}
